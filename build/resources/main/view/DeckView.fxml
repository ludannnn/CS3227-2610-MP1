<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" prefHeight="520.0" prefWidth="720.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="recall.gui.DeckViewController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <children>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <children>
                <Button text="&lt; Back" onAction="#handleBack" />
                <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            </children>
        </HBox>

        <ListView fx:id="cardList" VBox.vgrow="ALWAYS" />

        <HBox spacing="8.0">
            <children>
                <Button text="Delete card" onAction="#handleDelete" />
                <Button text="Review due cards" onAction="#handleReview" />
            </children>
        </HBox>

        <Label text="Add a card" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />
        <HBox spacing="8.0">
            <children>
                <TextField fx:id="frontField" promptText="Front" HBox.hgrow="ALWAYS" />
                <TextField fx:id="backField" promptText="Back" HBox.hgrow="ALWAYS" />
                <Button text="Add" onAction="#handleAdd" />
            </children>
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: #444444;" />
    </children>
</VBox>