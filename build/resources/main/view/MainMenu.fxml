<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" prefHeight="520.0" prefWidth="720.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="recall.gui.MainMenuController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <children>
        <Label text="Recall" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
        <Label text="Your decks" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />

        <ListView fx:id="deckList" VBox.vgrow="ALWAYS" />

        <HBox spacing="8.0">
            <children>
                <Button text="Open" onAction="#handleOpen" />
                <Button text="Delete" onAction="#handleDelete" />
            </children>
        </HBox>

        <Label text="New deck" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />
        <HBox spacing="8.0">
            <children>
                <TextField fx:id="newDeckField" promptText="Deck name" HBox.hgrow="ALWAYS" />
                <Button text="Create" onAction="#handleCreate" />
            </children>
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: #444444;" />
    </children>
</VBox>